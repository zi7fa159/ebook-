% --- Headings Styling ---
\usepackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\sffamily\color{DarkGray}}
  {\chaptertitlename\ \thechapter}{20pt}{\Huge}
\titlespacing*{\chapter}{0pt}{30pt}{20pt} % Spacing before and after chapter title

\titleformat{\section}
  {\normalfont\Large\bfseries\sffamily\color{DarkGray}}
  {\thesection}{1em}{}
\titlespacing*{\section}{0pt}{2.5ex plus 1ex minus .2ex}{1.5ex plus .2ex}

\titleformat{\subsection}
  {\normalfont\large\bfseries\sffamily\color{DarkGray}}
  {\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{2ex plus .5ex minus .2ex}{1ex plus .2ex}

\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\itshape\sffamily\color{DarkGray}}
  {\thesubsubsection}{1em}{}
\titlespacing*{\subsubsection}{0pt}{1.5ex plus .5ex minus .2ex}{0.8ex plus .2ex}

% Add a rule after chapter titles
\usepackage{etoolbox}
\patchcmd{\chapter}{\thispagestyle{plain}}{\thispagestyle{fancy}}{}{} % Ensure fancyhdr on chapter pages
\apptocmd{\chapter}{\par\noindent\textcolor{RuleColor}{\rule{\linewidth}{0.4pt}}\par\vspace{10pt}}{}{}


% --- Table of Contents Styling ---
\usepackage{tocbasic}
\DeclareTOCStyleEntry[
  dynnumwidth, % calculate width of numbers dynamically
  numsep=1em, % set separation between number and text
  entryformat=\sffamily, % Font for entries
  pagenumberformat=\sffamily % Font for page numbers
]{tocline}{chapter}

\DeclareTOCStyleEntry[
  dynnumwidth,
  numsep=1.5em, % Indent sections more
  entryformat=\sffamily,
  pagenumberformat=\sffamily
]{tocline}{section}

\DeclareTOCStyleEntry[
  dynnumwidth,
  numsep=2em, % Indent subsections more
  entryformat=\sffamily,
  pagenumberformat=\sffamily
]{tocline}{subsection}


% --- Header and Footer ---
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{} % Clear all header and footer fields
\fancyhead[LE,RO]{\sffamily\scriptsize\nouppercase{\leftmark}} % Chapter on Left (Even), Section on Right (Odd)
\fancyhead[RE,LO]{\sffamily\scriptsize\nouppercase{\rightmark}}
\fancyfoot[C]{\sffamily\scriptsize\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{ % Style for chapter starting pages, etc.
  \fancyhf{}
  \fancyfoot[C]{\sffamily\scriptsize\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

% --- Title Page (Text-Based Cover) ---
% This will be primarily driven by Pandoc metadata, but we can add styling here.
% The actual content (title, subtitle, author) comes from 00-title.md and Pandoc vars.
\newcommand{\makecover}{
    \thispagestyle{empty}
    \newgeometry{margin=1in} % Ensure full margins for cover page
    \begin{titlepage}
        \centering
        \vspace*{\stretch{1.5}} % Push content down a bit

        {\sffamily\bfseries\Huge\MakeTextUppercase{$title$}\par}
        \vspace{0.5cm}
        {\sffamily\LARGE $subtitle$\par}

        \vspace{\stretch{1}}

        {\sffamily\Large $author$\par}
        \vspace{0.25cm}
        {\sffamily\normalsize $date$\par}

        \vspace*{\stretch{2}}
    \end{titlepage}
    \restoregeometry % Restore original geometry after cover page
    \cleardoublepage
    \pagestyle{fancy} % Ensure subsequent pages use fancy style
}

