<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <TextureView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/last_capture_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/status_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:padding="16dp"
        android:orientation="vertical"
        android:background="#80000000">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textColor="#FFF" />

        <TextView
            android:id="@+id/exposure_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shutter: 1.00s | ISO: 800"
            android:textColor="#FFF"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/session_settings_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frames: 100 | Delay: 0.5s"
            android:textColor="#FFF"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/frame_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frames: 0/100"
            android:textColor="#FFF"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controls_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#80000000">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shutter Speed (3 turns / sec)"
            android:textColor="#FFF"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal" />

        <com.example.astroapp.PrecisionWheelView
            android:id="@+id/shutter_wheel"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ISO (Logarithmic)"
            android:textColor="#FFF"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal" />

        <com.example.astroapp.PrecisionWheelView
            android:id="@+id/iso_wheel"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <Button
            android:id="@+id/capture_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="START CAPTURE" />
    </LinearLayout>

</RelativeLayout>
