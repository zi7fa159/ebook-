<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#AA000000"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/timerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stacked: 0 | Time: 00:00"
                android:textColor="#00FF00"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Idle"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/sensorInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exposure: 1.0s | ISO: 800 | Focus: Inf"
            android:textColor="#FFFF00"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:background="#EE111111"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SETTINGS" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp" android:layout_marginBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exposure (sec)" android:textColor="#AAAAAA" />
        <EditText android:id="@+id/editExposure" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:text="1.0" android:textColor="#FFFFFF" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ISO" android:textColor="#AAAAAA" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/editISO" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="800" android:textColor="#FFFFFF" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Focus (0=Inf, 10=Macro)" android:textColor="#AAAAAA" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/editFocus" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:text="0.0" android:textColor="#FFFFFF" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stack Mode" android:textColor="#AAAAAA" android:layout_marginTop="8dp" />
        <Spinner android:id="@+id/spinnerAlgo" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333333" />

        <CheckBox android:id="@+id/checkAlign" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Star Alignment" android:textColor="#FFFFFF" android:checked="true" android:layout_marginTop="16dp" />
        <CheckBox android:id="@+id/checkRaw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Use RAW_SENSOR" android:textColor="#FFFFFF" android:checked="false" />

        <Button android:id="@+id/btnDark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CAPTURE DARK" android:backgroundTint="#4444FF" android:layout_marginTop="8dp" />

        <Button android:id="@+id/btnApply" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="APPLY" android:layout_marginTop="24dp" />
        <Button android:id="@+id/btnCloseMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CLOSE" android:backgroundTint="#444444" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:padding="8dp"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?android:attr/selectableItemBackground" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <Button android:id="@+id/btnStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="START" android:backgroundTint="#228B22" />
        <Button android:id="@+id/btnStop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STOP" android:enabled="false" android:backgroundTint="#B22222" android:layout_marginHorizontal="4dp" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <ToggleButton android:id="@+id/toggleStretch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textOn="STRETCH" android:textOff="LINEAR" android:checked="true" />

        <Button android:id="@+id/btnSave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAVE" android:layout_marginLeft="4dp" />
        <Button android:id="@+id/btnReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R" android:minWidth="40dp" android:layout_marginLeft="4dp" />

    </LinearLayout>

</RelativeLayout>
